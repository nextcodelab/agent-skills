// DitherDissolve — generated from https://github.com/gl-transitions/gl-transitions/blob/master/transitions/DitherDissolve.glsl
// Author: gre
// License: MIT
// Description: The incoming image appears through a regular 8x8 ordered dither pattern, like a retro computer screen

uniform shader _from;
uniform shader _to;
uniform float2 _resolution;
uniform float progress;
uniform float ratio;

vec4 getFromColor(vec2 uv) { return vec4(unpremul(_from.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }
vec4 getToColor(vec2 uv) { return vec4(unpremul(_to.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }

uniform float dotSize; 

float bayer(vec2 c) {
  float v = 0.0;
  float scale = 16.0;
  for (int i = 0; i < 3; i++) {
    vec2 bit = mod(floor(c), 2.0);
    
    v += scale * (2.0 * abs(bit.x - bit.y) + bit.y);
    c *= 0.5;
    scale *= 0.25;
  }
  return (v + 0.5) / 64.0;
}

vec4 transition(vec2 uv) {
  vec2 cell = floor(uv * vec2(ratio, 1.0) / dotSize);
  return progress < bayer(cell) ? getFromColor(uv) : getToColor(uv);
}

half4 main(float2 _coord) {
  vec2 _uv = _coord / _resolution;
  vec4 _c = clamp(transition(vec2(_uv.x, 1.0 - _uv.y)), 0.0, 1.0);
  return half4(_c.rgb * _c.a, _c.a);
}
