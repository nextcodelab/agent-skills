// FallOver — generated from https://github.com/gl-transitions/gl-transitions/blob/master/transitions/FallOver.glsl
// Author: gre
// License: MIT
// Description: The outgoing image falls over backward, hinged on its bottom edge, revealing the incoming one behind it

uniform shader _from;
uniform shader _to;
uniform float2 _resolution;
uniform float progress;
uniform float ratio;

vec4 getFromColor(vec2 uv) { return vec4(unpremul(_from.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }
vec4 getToColor(vec2 uv) { return vec4(unpremul(_to.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }

uniform float perspective; 

uniform float shading; 

const float PI = 3.141592653589793;

vec4 transition (vec2 uv) {
  
  float fall = progress * (0.25 + 0.75 * progress);
  float angle = 0.5 * PI * fall;
  float c = cos(angle), s = sin(angle);
  
  
  float dist = 1.0 / max(perspective, 0.01);
  vec3 eye = vec3(0.5 * ratio, 0.5 * c, -dist);
  vec3 dir = vec3(uv.x * ratio, uv.y, 0.0) - eye;
  
  float den = dir.z * c - dir.y * s;
  if (den > 0.0) {
    float t = (eye.y * s - eye.z * c) / den;
    vec3 hit = eye + t * dir;
    vec2 puv = vec2(hit.x / ratio, hit.y * c + hit.z * s);
    if (t > 0.0 && puv.y > 0.0 && puv.y <= 1.0 && puv.x >= 0.0 && puv.x <= 1.0) {
      vec4 col = getFromColor(puv);
      return vec4(col.rgb * (1.0 - shading * s), col.a);
    }
  }
  return getToColor(uv);
}

half4 main(float2 _coord) {
  vec2 _uv = _coord / _resolution;
  vec4 _c = clamp(transition(vec2(_uv.x, 1.0 - _uv.y)), 0.0, 1.0);
  return half4(_c.rgb * _c.a, _c.a);
}
