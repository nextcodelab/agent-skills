// HeartWipe — generated from https://github.com/gl-transitions/gl-transitions/blob/master/transitions/HeartWipe.glsl
// Author: gre
// License: MIT
// Description: A heart grows from the center with a little heartbeat to reveal the incoming image

uniform shader _from;
uniform shader _to;
uniform float2 _resolution;
uniform float progress;
uniform float ratio;

vec4 getFromColor(vec2 uv) { return vec4(unpremul(_from.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }
vec4 getToColor(vec2 uv) { return vec4(unpremul(_to.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }

uniform vec2 center; 

uniform float smoothness; 

uniform float pulse; 

uniform vec3 glowColor; 

uniform float glow; 

float dot2(vec2 v) { return dot(v, v); }

float sdHeart(vec2 p) {
  p.x = abs(p.x);
  if (p.x + p.y > 1.0) return sqrt(dot2(p - vec2(0.25, 0.75))) - 0.35355339;
  return sqrt(min(dot2(p - vec2(0.0, 1.0)), dot2(p - 0.5 * max(p.x + p.y, 0.0)))) * sign(p.x - p.y);
}

float heartScale(vec2 p) {
  float l = length(p);
  if (l < 1e-6) return 0.0;
  vec2 d = vec2(abs(p.x), p.y) / l;
  vec2 m = vec2(0.0, 0.55) - vec2(0.25, 0.75);
  float b = dot(m, d);
  float tDisk = -b + sqrt(b * b - dot2(m) + 0.35355339 * 0.35355339);
  float tSide = d.x > d.y ? vec2(0.0, 0.55).y / (d.x - d.y) : 1e6;
  float tTop = d.x + d.y > 0.0 ? (1.0 - vec2(0.0, 0.55).y) / (d.x + d.y) : 1e6;
  return l / max(tDisk, min(tSide, tTop));
}

vec4 transition (vec2 uv) {
  vec4 a = getFromColor(uv);
  vec4 b = getToColor(uv);
  vec2 asp = vec2(ratio, 1.0);
  vec2 c = center * asp;
  
  
  float cx = clamp(center.x, 0.0, 1.0) * ratio;
  float full = max(
    max(max(heartScale(vec2(0.0, 0.0) - c), heartScale(vec2(ratio, 0.0) - c)),
        max(heartScale(vec2(0.0, 1.0) - c), heartScale(vec2(ratio, 1.0) - c))),
    heartScale(vec2(cx, 1.0) - c));
  float sm = max(smoothness, 0.001);
  
  full += 4.0 * sm;

  
  float p = progress;
  float e = p * p * (2.0 - p);
  float env = max(sin(3.14159265 * p), 0.0);
  float beat = sin(6.28318531 * 2.0 * p) * env * env;
  float s = full * clamp(e + 0.09 * pulse * beat, 0.0, 1.0);
  if (s <= 0.0) return a;

  vec2 q = uv * asp - c;
  float d = s * sdHeart(q / s + vec2(0.0, 0.55));
  float m = smoothstep(0.0, sm, -d);
  vec4 col = mix(a, b, m);
  
  float light = exp(-max(d, 0.0) / (0.008 + sm)) * (1.0 - m) * glow * min(1.0, 4.0 * env);
  return col + vec4(glowColor * light, 0.0);
}

half4 main(float2 _coord) {
  vec2 _uv = _coord / _resolution;
  vec4 _c = clamp(transition(vec2(_uv.x, 1.0 - _uv.y)), 0.0, 1.0);
  return half4(_c.rgb * _c.a, _c.a);
}
