// TvRoll — generated from https://github.com/gl-transitions/gl-transitions/blob/master/transitions/TvRoll.glsl
// Author: gre
// License: MIT
// Description: The outgoing image rolls faster and faster, like an old TV losing its vertical hold, then the roll slows down and locks on the incoming image

uniform shader _from;
uniform shader _to;
uniform float2 _resolution;
uniform float progress;
uniform float ratio;

vec4 getFromColor(vec2 uv) { return vec4(unpremul(_from.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }
vec4 getToColor(vec2 uv) { return vec4(unpremul(_to.eval(vec2(uv.x, 1.0 - uv.y) * _resolution))); }

uniform int rolls; 

uniform float barHeight; 

uniform vec4 barColor; 

vec4 picture(vec2 uv, float y, float m) {
  float period = 1.0 + barHeight;
  y = mod(y, period);
  if (y > 1.0) return barColor;
  vec2 q = vec2(uv.x, y);
  return mix(getFromColor(q), getToColor(q), m);
}

vec4 transition(vec2 uv) {
  float period = 1.0 + barHeight;
  
  float s = progress * progress * (3.0 - 2.0 * progress);
  float offset = period * fract(float(rolls) * s);
  float speed = 4.0 * progress * (1.0 - progress); 
  float m = smoothstep(0.42, 0.58, progress); 
  
  vec2 p = uv + vec2(0.004 * speed * sin(uv.y * 9.0 + progress * 30.0), 0.0);
  
  vec4 c = vec4(0.0);
  for (int i = 0; i < 5; i++) {
    c += picture(p, p.y + offset - 0.0015 * float(rolls) * speed * float(i), m);
  }
  c /= 5.0;
  
  float scan = 0.5 + 0.5 * sin(uv.y * 400.0);
  float flicker = 0.08 * (0.5 + 0.5 * sin(progress * 97.0));
  c.rgb *= 1.0 - speed * (0.08 * scan + flicker);
  return c;
}

half4 main(float2 _coord) {
  vec2 _uv = _coord / _resolution;
  vec4 _c = clamp(transition(vec2(_uv.x, 1.0 - _uv.y)), 0.0, 1.0);
  return half4(_c.rgb * _c.a, _c.a);
}
